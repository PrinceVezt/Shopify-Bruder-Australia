{%- comment -%}
    Secondary Navigation snippet — embedded directly inside header.liquid
    so it inherits Dawn's own sticky-header behavior instead of fighting it
    as an independent sibling section.

    Call from header.liquid like:
    {% render 'secondary-navigation_1',
        id_menu: section.settings.id_menu,
        id_bg_color: section.settings.id_bg_color,
        id_alignment: section.settings.id_alignment
    %}

    The three schema settings (id_menu, id_bg_color, id_alignment) live in
    header.liquid's own { % schema % } block, not here — snippets can't have
    their own schema.

    Submenus: uses Shopify's native one-level-deep nested links (link.links)
    from the linklist assigned to id_menu. Set those up in Online Store →
    Navigation the normal way — no extra schema setting needed here.
{%- endcomment -%}

{% style %}
    .secondary-nav-embedded {
        background-color: {{ id_bg_color }};
        width: 100%;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        position: relative;
        z-index: 10;
    }

    .secondary-nav-embedded .secondary-nav__inner {
        display: flex;
        justify-content: {{ id_alignment }};
        max-width: 1200px;
        margin: 0 auto;
    }

    .secondary-nav-embedded ul {
        display: flex;
        align-items: stretch;
        gap: 2.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
    }

    .secondary-nav-embedded li {
        position: relative;
        display: flex;
        align-items: stretch;
    }

    .secondary-nav-embedded a {
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        color: #000;
        font-weight: 600;
        font-size: 1.8rem;
        white-space: nowrap;
        text-transform: uppercase;
        line-height: 3;
        position: relative;
    }

    /* Bobcat-style bottom bar: sits flush with the bottom edge of the nav row */
    .secondary-nav-embedded li > a::after {
        content: "";
        position: absolute;
        left: -10px;
        right: -10px;
        bottom: -1px;
        height: 6px;
        background: var(--yellow, #ffcd03);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.2s ease;
    }

    .secondary-nav-embedded li > a:hover::after,
    .secondary-nav-embedded li > a[aria-current="page"]::after,
    .secondary-nav-embedded li.has-active-child > a::after {
        transform: scaleX(1);
    }

    .secondary-nav-embedded a[aria-current="page"],
    .secondary-nav-embedded li.has-active-child > a {
        color: #000;
    }

    /* Dropdown chevron, only shown on items with submenus */
    .secondary-nav-embedded .nav-caret {
        width: 10px;
        height: 10px;
        flex-shrink: 0;
        transition: transform 0.15s ease;
    }

    .secondary-nav-embedded li.has-submenu:hover .nav-caret,
    .secondary-nav-embedded li.has-submenu:focus-within .nav-caret {
        transform: rotate(180deg);
    }

    /* Submenu panel */
    .secondary-nav-embedded .submenu {
        display: block;
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 220px;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        list-style: none;
        margin: 0;
        padding: 8px 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
        z-index: 20;
    }

    .secondary-nav-embedded li.has-submenu:hover > .submenu,
    .secondary-nav-embedded li.has-submenu:focus-within > .submenu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .secondary-nav-embedded .submenu li {
        display: block;
    }

    .secondary-nav-embedded .submenu a {
        display: block;
        font-size: 1.4rem;
        font-weight: 500;
        line-height: 1.8;
        padding: 8px 20px;
        text-transform: none;
        white-space: nowrap;
    }

    .secondary-nav-embedded .submenu a::after {
        display: none;
    }

    .secondary-nav-embedded .submenu a:hover {
        background: #f5f5f5;
    }

    @media (max-width: 749px) {
        .secondary-nav-embedded .secondary-nav__inner {
            justify-content: flex-start;
            overflow-x: auto;
            padding: 0.8rem 1.25rem;
        }
        .secondary-nav-embedded ul {
            flex-wrap: nowrap;
            gap: 1.5rem;
        }
        .secondary-nav-embedded .submenu {
            position: static;
            box-shadow: none;
            opacity: 1;
            visibility: visible;
            transform: none;
            display: none;
            min-width: 0;
        }
        .secondary-nav-embedded li.has-submenu:focus-within .submenu {
            display: block;
        }
    }
{% endstyle %}

<nav class="secondary-nav-embedded" aria-label="Secondary">
    <div class="secondary-nav__inner">
        <ul>
            {%- for link in id_menu.links -%}
                {%- liquid
                    assign has_submenu = false
                    assign has_active_child = false
                    if link.links.size > 0
                        assign has_submenu = true
                    endif
                    for child in link.links
                        if child.active
                            assign has_active_child = true
                        endif
                    endfor
                -%}
                <li class="{% if has_submenu %}has-submenu{% endif %} {% if has_active_child %}has-active-child{% endif %}">
                    <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                        {{ link.title }}
                        {%- if has_submenu -%}
                            <svg class="nav-caret" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        {%- endif -%}
                    </a>
                    {%- if has_submenu -%}
                        <ul class="submenu">
                            {%- for child in link.links -%}
                                <li>
                                    <a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>
                                        {{ child.title }}
                                    </a>
                                </li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}
                </li>
            {%- endfor -%}
        </ul>
    </div>
</nav>
